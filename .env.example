GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: free photos for slides. Get a key at https://www.pexels.com/api/ (leave as is to use emoji art instead)
PEXELS_API_KEY=paste_your_pexels_key_here

# Optional: free account key at https://enter.pollinations.ai - removes the 15-second wait between AI images
POLLINATIONS_API_KEY=paste_your_pollinations_key_here

# Best free image generator (Cloudflare Workers AI, FLUX). dash.cloudflare.com -> AI -> Workers AI -> Use REST API
CF_ACCOUNT_ID=paste_your_cloudflare_account_id_here
CF_API_TOKEN=paste_your_cloudflare_api_token_here

# Optional: real stock photos (free, instant key after sign-up): https://pixabay.com/api/docs/
PIXABAY_API_KEY=paste_your_pixabay_key_here
